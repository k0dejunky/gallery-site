RewriteEngine On

# Allow a single upload up to 10 GiB. Multipart overhead is included in the
# request limit so PHP does not reject a file at the exact configured ceiling.
php_value upload_max_filesize 10G
php_value post_max_size 11G

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
