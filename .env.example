GALLERY_DB_HOST=127.0.0.1
GALLERY_DB_PORT=3306
GALLERY_DB_NAME=gallery_mvc
GALLERY_DB_USER=gallery
GALLERY_DB_PASSWORD=replace-this-value

# Mail. Sent via the site's own mail server (Postfix + Dovecot SASL on the
# mail domain itself), authenticated with a mailbox on that domain.
MAIL_HOST=amethyst2213.com
MAIL_PORT=587
MAIL_USERNAME=admin@amethyst2213.com
MAIL_PASSWORD=replace-with-mailbox-password
MAIL_FROM=admin@amethyst2213.com
# Admin communications (system alerts, test emails) go to this mailbox.
ADMIN_EMAIL=admin@amethyst2213.com
APP_URL=https://example.com/gallery

# Optional hardening/integration settings.
# APP_ENV=production
# APP_DEBUG=false
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Session idle timeout and recovery limits use safe defaults in config/app.php.
