[Unit]
Description=Gallery video export queue worker
After=network.target mysql.service php8.3-fpm.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/gallery
ExecStart=/usr/bin/php /var/www/gallery/bin/video_export_queue.php
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
