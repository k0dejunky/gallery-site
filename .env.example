GALLERY_DB_HOST=127.0.0.1
GALLERY_DB_PORT=3306
GALLERY_DB_NAME=gallery_mvc
GALLERY_DB_USER=gallery
GALLERY_DB_PASSWORD=replace-this-value

# Gmail SMTP. Use a Google App Password, not the normal account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=your-gmail-address@gmail.com
APP_URL=https://example.com/gallery

# Optional hardening/integration settings.
# APP_ENV=production
# APP_DEBUG=false
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Session idle timeout and recovery limits use safe defaults in config/app.php.
